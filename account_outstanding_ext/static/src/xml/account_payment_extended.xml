<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="account.AccountPaymentField" t-inherit-mode="extension">
        <xpath expr="//td[@style='max-width: 11em;']" position="replace">
            <td style="max-width: 100%; padding-left: 10px;">
                <a role="button"
                   class="oe_form_field btn btn-link open_account_move"
                   t-on-click="() => this.openMove(line.move_id)"
                   style="text-align: left; white-space: normal; display: block; padding: 0;"
                   title="Ver detalles">

                    <span style="font-weight: bold; color: #212529; display: block;">
                        <t t-esc="line.move_name_custom || line.journal_name"/>
                    </span>

                    <t t-if="line.ref_custom">
                        <div style="font-size: 0.85em; color: #666; font-style: italic;">
                            Ref: <t t-esc="line.ref_custom"/>
                        </div>
                    </t>

                    <div class="text-muted" style="font-size: 0.8em;">
                        <t t-esc="line.formattedDate"/>
                    </div>
                </a>
            </td>
        </xpath>
    </t>
</templates>